{
  "name": "lawtrack",
  "version": "0.1.0",
  "private": true,
  "description": "LawTrack — citizen-centric legal assistance portal (prototype)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "npm install && node --import tsx scripts/ensure-env.ts && npm run db:migrate && npm run db:seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:report": "node --import tsx scripts/run-test-report.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --import ./scripts/server-only-shim.mjs --import tsx scripts/db-migrate.ts",
    "db:seed": "node --import ./scripts/server-only-shim.mjs --import tsx scripts/db-seed.ts",
    "db:reset": "node --import ./scripts/server-only-shim.mjs --import tsx scripts/db-reset.ts",
    "db:seed:metrics": "node --import ./scripts/server-only-shim.mjs --import tsx scripts/seed-metrics.ts"
  },
  "dependencies": {
    "@google/genai": "^3.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.90.2",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.1.1",
    "jose": "^6.2.17",
    "kysely": "^0.28.7",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
