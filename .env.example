# ---------------------------------------------------------------------------
# LawTrack environment. Copy to `.env` (npm run setup does this for you).
# Never commit a real .env — this file is the template only.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port used by the Next.js server (npm run dev / npm start).
PORT=3000

# Canonical browser origin. Used for cookie + Origin checks (CSRF defence).
CLIENT_ORIGIN=http://localhost:3000

# JWT signing secret. MUST be at least 32 characters in production.
# Replace this development placeholder before deploying.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please

# SQLite database file (relative paths resolve from the project root).
DB_PATH=./data/lawtrack.db

# Google Gemini. Leave GEMINI_API_KEY empty to run in offline "Mock AI" mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Number of knowledge-base passages retrieved per chat question.
RAG_TOP_K=4

# Background jobs (case sync, reminders, health checks). Disable in tests.
JOBS_ENABLED=true

# eCourts adapter: `mock` (deterministic fixtures, no network) or `real`
# (the stub throws 503 NOT_CONFIGURED until a real client is implemented).
ECOURTS_MODE=mock

# Development-only: show the last OTP on screen instead of only in the log.
# Ignored (forced off) when NODE_ENV=production.
DEV_SHOW_OTP=true
